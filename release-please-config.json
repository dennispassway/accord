{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "accord",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "toml",
          "path": "src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        }
      ]
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Nieuw" },
    { "type": "fix", "section": "Opgelost" },
    { "type": "perf", "section": "Sneller" },
    { "type": "refactor", "section": "Onder de motorkap" },
    { "type": "docs", "section": "Documentatie", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Overig", "hidden": true },
    { "type": "style", "section": "Opmaak", "hidden": true }
  ]
}
